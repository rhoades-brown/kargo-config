name: penpot
namespace: penpot

gitRepo: https://github.com/rhoades-brown/argo-config.git
targetRevision: kargo-penpot-prod.01ksgqxtwp96n9r036gd6g6vw5.7852afd

chart:
  repoURL: http://helm.penpot.app
  name: penpot
  version: 0.42.0

valuesFile: valuesfiles/penpot.yaml
manifestsPath: manifests/penpot

kargo:
  enabled: true
  project: kargo-penpot
  autoPromotionEnabled: true
  warehouse:
    interval: 1h0m0s
    images: []
    chart:
      repoURL: http://helm.penpot.app
      name: penpot
      semverConstraint: ">=0.38.0 <0.43.0"
  stage:
    imageUpdates: []
